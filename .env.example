APP_NAME=CabMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cabme
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Outgoing mail — REQUIRED
# ---------------------------------------------------------------------------
# Password-reset codes, receipts and payout notices all go through here.
#
# Use `smtp` with your provider's credentials. Avoid `sendmail` on a server
# with no configured MTA: it does not raise an error, the app reports the mail
# as sent, and the message is silently dropped — which looks exactly like
# "the reset code never arrives".
#
# MAIL_FROM_ADDRESS must be a mailbox the provider lets you send from, or the
# message is accepted and then discarded as spoofed.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# REQUIRED for any notification to send. It is the project id shown in the
# Firebase console under Project settings -> General ("Project ID"), and it
# forms the send url: https://fcm.googleapis.com/v1/projects/<id>/messages:send
#
# The matching service-account JSON is uploaded in the admin under
# Settings -> Notifications, not stored here. Both must belong to the SAME
# Firebase project or every send is rejected.
FIREBASE_PROJECT_ID=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
